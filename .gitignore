# ─── Secretos y entorno ──────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example
# Estas exclusiones no protegen secretos ya versionados; si se expusieron, rótalos.

# ─── Dependencias ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
__pycache__/
*.py[cod]
.venv/
venv/

# ─── Build / distribución ────────────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.output/
*.egg-info/
# Generado por Next en cada `dev`, `build` o `typegen`: sus rutas cambian según
# el comando, así que ensucia el árbol sin aportar nada. Lo usa `tsconfig.json`.
next-env.d.ts

# ─── Caché y herramientas ────────────────────────────────────────────────────
.cache/
.turbo/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
coverage/
.nyc_output/

# ─── Editores y SO ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
*.suo
*.user

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
