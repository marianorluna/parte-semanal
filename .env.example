# Copia a `.env`; descomenta y adapta solo las variables necesarias.
# No commitees archivos con secretos. Las plantillas `.env.example` y
# `.env.*.example` sí se versionan y nunca deben contener secretos reales.

# --- Aplicación -------------------------------------------------------------
# NODE_ENV=development
# URL pública de la app. En local, http://localhost:3000.
# En producción: https://horas.levitec.marianorluna.com
# APP_URL=http://localhost:3000
# Zona horaria del contenedor y de las fechas de negocio.
# TZ=Europe/Madrid

# --- Base de datos ----------------------------------------------------------
# Solo para desarrollo con `npm run dev`. El stack completo (`compose.yml`)
# construye la URL interna a partir de las variables POSTGRES_* de abajo.
# DATABASE_URL=postgresql://parte_diario:parte_diario@localhost:5432/parte_diario

# --- Stack Docker Compose / Coolify -----------------------------------------
# Credenciales del servicio `db`. La app recibe montada la URL interna
# (`db:5432`), así que no hay que escribir DATABASE_URL a mano.
# Contraseña fuerte y compatible con una URL: openssl rand -hex 24
# POSTGRES_USER=parte_diario
# POSTGRES_PASSWORD=
# POSTGRES_DB=parte_diario
# Puerto del host para el Postgres local. Solo lo aplica `compose.override.yml`
# (desarrollo); en Coolify el `db` no publica puertos. Escucha en 127.0.0.1.
# DB_PORT=5432
# Opcional en Coolify: pide a Coolify que asigne dominio al servicio `app` en
# el puerto 3000, en lugar de rellenarlo en la pantalla del recurso.
# SERVICE_FQDN_APP_3000=https://horas.levitec.marianorluna.com

# --- Autenticación ----------------------------------------------------------
# Genera un secreto propio por entorno con: openssl rand -base64 32
# AUTH_SECRET=

# --- Datos de demostración --------------------------------------------------
# Contraseña común de las cuentas de prueba. El email sigue el formato
# inicial del nombre + apellidos sobre el dominio corporativo (dsierra@levitec.es).
# Cámbiala fuera de local.
# DEMO_PASSWORD=Demo1234!

# Provisional: muestra en el login tres botones de acceso rápido con las cuentas
# demo (ADMIN, ENCARGADO, TRABAJADOR). La contraseña se resuelve en el servidor.
# Déjalo sin definir o en false al terminar el periodo de pruebas.
# ACCESO_RAPIDO_DEMO=true

# --- Avisos y automatizaciones ----------------------------------------------
# Secreto del endpoint /api/v1/cron/avisos. Sin él, el endpoint responde 503 y
# no se generan recordatorios. Genera uno con: openssl rand -hex 32
# CRON_SECRET=
# SMTP de salida para los avisos por correo. Sin SMTP_URL la app funciona igual:
# los envíos quedan en estado SIN_PROVEEDOR y se pueden reintentar al configurarla.
# El formato es el de nodemailer, por ejemplo:
# smtps://usuario:clave@smtp.proveedor.com:465
# SMTP_URL=
# Remitente visible. Por defecto, no-reply@levitec.es.
# SMTP_FROM=Parte semanal <no-reply@levitec.es>

# --- Integraciones (fase 2; no configurar todavía) --------------------------
# API_KEY=
# WEBHOOK_SECRET=
# S3_BACKUP_BUCKET=
